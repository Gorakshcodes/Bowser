PORT=3000

# Production database
# Set DATABASE_URL on Vercel (or locally) to persist accounts, classes, and homework metadata.
DATABASE_URL=
# Set to false only if your Postgres provider explicitly does not require SSL.
DATABASE_SSL=true

# Admin portal bootstrap account
# Add these so an admin can log in and activate new teacher/student accounts.
# ADMIN_PASSWORD is hashed before it is stored; changing it here updates the admin login.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Bowser Admin
# Optional mobile for admin SMS login codes (E.164, e.g. +919876543210)
ADMIN_PHONE=

# Login session signing key.
# Optional for local dev: when empty the app generates one and keeps it with the portal data.
# Required for production / Vercel: use a long random string so sessions survive
# redeploys and stay valid across multiple server instances.
# Example: openssl rand -hex 32
SESSION_SECRET=

# Two-factor login: password, then 6-digit SMS code
# Preferred: Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Used when users enter a local number without +country code
SMS_DEFAULT_COUNTRY_CODE=+91

# Optional alternative to Twilio: POST JSON { phone, to, text, code, name, email }
SMS_WEBHOOK_URL=
# Legacy alias also accepted:
OTP_WEBHOOK_URL=

# Force showing the code in the browser even when SMS is sent (useful for debugging)
EXPOSE_LOGIN_OTP=

# Educational AI (optional). OpenAI-compatible APIs work (OpenAI, Groq, OpenRouter, SpaceXAI, etc.)
# Without a key, Bowser uses free offline teaching templates (and Ollama if running locally).
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Free local option if you run Ollama: https://ollama.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Without Twilio/SMS_WEBHOOK_URL the code is shown on screen and logged as:
#   [2FA] Login code for you@email.com / +91...: 123456

# Zoom Server-to-Server OAuth configuration
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Zoom user email or user id used to create meetings
ZOOM_USER_ID=teacher@yourdomain.com

# Google Meet automatic link creation, through the Google Calendar API.
# Leave these empty to keep Google Meet as a paste-your-own-link option.
# The app creates a calendar event with a Meet conference attached and saves the join link.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Calendar that owns the created events. "primary" is that account's own calendar.
GOOGLE_CALENDAR_ID=primary

# Timezone used when creating Zoom and Google Meet meetings.
MEETING_TIMEZONE=Asia/Riyadh

# Microsoft Teams meetings currently use manual join links in the app,
# so no Teams API credentials are required for basic scheduling.
